# ============================================================
# RD-Agent 配置模板  (DeepSeek + SiliconFlow embedding)
# ------------------------------------------------------------
# ⚠️ 这份文件只在"本地部署"阶段使用(未来把这套环境搬回 Mac 时)。
#
# 云端 Codespaces 阶段不用这个文件:两个密钥改用
# GitHub Codespaces Secrets 注入(设置方法见仓库 README),
# 非敏感配置写在 .devcontainer/devcontainer.json 的 remoteEnv 里。
# 这样 Key 全程不落地到任何文件、不进 git 历史。
#
# 本地部署时的用法:
#   cp .env.template .env
#   然后编辑 .env,把下面两个 <...> 换成你自己的 Key
#
# ⚠️ .env 已在 .gitignore 里,永远不会被提交。
# ⚠️ 不要把 Key 贴进聊天、不要写进任何 .py / .yml 文件。
#
# 配置来源:RD-Agent 官方文档
# https://rdagent.readthedocs.io/en/latest/installation_and_configuration.html
# ============================================================

# --- CHAT MODEL: DeepSeek 官方 API ---
CHAT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=<replace_with_your_deepseek_api_key>

# --- EMBEDDING MODEL ---
# DeepSeek 官方没有 embedding 接口,所以 embedding 走硅基流动(SiliconFlow)。
# 注意:embedding 必须带 litellm_proxy/ 前缀,这是 RD-Agent 官方文档明确要求的。
EMBEDDING_MODEL=litellm_proxy/BAAI/bge-m3
LITELLM_PROXY_API_KEY=<replace_with_your_siliconflow_api_key>
LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1

# --- 推理模型思维链 ---
# DeepSeek 的 reasoning 模型返回带 think 过程时需要打开
REASONING_THINK_RM=True

# ============================================================
# 以下是"长期长跑"相关配置,首次试跑保持注释状态即可。
# 想连续跑多轮时,取消注释并调大数值。
# ============================================================

# 日志落盘位置。留空则默认 = 当前工作目录/log/<UTC时间戳>,
# 也就是 ~/quant/rdagent/log/<时间戳>/ ——每跑一轮生成一个新目录,历史不会被覆盖。
# 只要始终在 ~/quant/rdagent/ 下启动,就不用动这一行。
# LOG_TRACE_PATH=

# fin_factor 的训练/验证/测试时间切分(官方默认 2008-2020)
# 换成 J-Quants 日股数据时,这几行是需要改的地方之一。
# QLIB_FACTOR_TRAIN_START=2008-01-01
# QLIB_FACTOR_TRAIN_END=2014-12-31
# QLIB_FACTOR_VALID_START=2015-01-01
# QLIB_FACTOR_VALID_END=2016-12-31
# QLIB_FACTOR_TEST_START=2017-01-01
# QLIB_FACTOR_TEST_END=2020-08-01
